NEXT_PUBLIC_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=your-project-id
# Single TablesDB database (the Appwrite Free plan allows one). The id is "notemind" for historical reasons.
APPWRITE_DATABASE_ID=notemind
APPWRITE_BUCKET_ID=documents
# Legacy NoteMind table, only used by the one-click "Import notes" migration.
APPWRITE_NOTES_TABLE_ID=notes
# Server-only secret, never sent to the browser. Scopes: users.write, sessions.write,
# databases.read/write, tables.read/write, columns.write, indexes.write, rows.read/write,
# buckets.read/write, files.read/write, embeddings.write (sites.write only for scripted Sites setup)
APPWRITE_API_KEY=
# Public URL of the deployed site. Used as the allowed browser Origin for /mcp.
NEXT_PUBLIC_APP_URL=https://engram-ai.appwrite.network
# Server-only secret (32+ chars) used to HMAC new engram_ keys. Generate with: openssl rand -hex 32
# Keep it: changing it invalidates every engram_ key. Never expose it to the browser.
ENGRAM_KEY_PEPPER=
# Optional extra browser origins allowed to call /mcp (comma-separated), e.g. a web-based MCP inspector.
ENGRAM_ALLOWED_ORIGINS=
